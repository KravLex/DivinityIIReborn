diff --git a/src/d3d9/d3d9_frame_census.cpp b/src/d3d9/d3d9_frame_census.cpp
new file mode 100644
index 0000000..8826214
--- /dev/null
+++ b/src/d3d9/d3d9_frame_census.cpp
@@ -0,0 +1,426 @@
+#include "d3d9_frame_census.h"
+
+#include "d3d9_options.h"
+#include "d3d9_shader.h"
+#include "d3d9_surface.h"
+#include "d3d9_texture.h"
+
+#include "../util/log/log.h"
+#include "../util/sha1/sha1_util.h"
+#include "../util/util_env.h"
+#include "../util/util_string.h"
+
+#include <cstdio>
+#include <ctime>
+#include <fstream>
+#include <sstream>
+
+namespace dxvk {
+
+  static std::string FormatName(D3D9Format Format) {
+    switch (uint32_t(Format)) {
+      case 0:   return "NULL";
+      case 20:  return "R8G8B8";
+      case 21:  return "A8R8G8B8";
+      case 22:  return "X8R8G8B8";
+      case 23:  return "R5G6B5";
+      case 31:  return "A2B10G10R10";
+      case 32:  return "A8B8G8R8";
+      case 34:  return "G16R16";
+      case 35:  return "A2R10G10B10";
+      case 36:  return "A16B16G16R16";
+      case 50:  return "L8";
+      case 71:  return "D16_LOCKABLE";
+      case 75:  return "D24S8";
+      case 77:  return "D24X8";
+      case 80:  return "D16";
+      case 82:  return "D32F_LOCKABLE";
+      case 111: return "R16F";
+      case 112: return "G16R16F";
+      case 113: return "A16B16G16R16F";
+      case 114: return "R32F";
+      case 115: return "G32R32F";
+      case 116: return "A32B32G32R32F";
+    }
+
+    uint32_t v = uint32_t(Format);
+    char fourcc[5] = { char(v), char(v >> 8), char(v >> 16), char(v >> 24), 0 };
+    bool printable = v > 0xFFu;
+
+    for (uint32_t i = 0; i < 4 && printable; i++)
+      printable = fourcc[i] >= 0x20 && fourcc[i] < 0x7F;
+
+    return printable ? std::string(fourcc) : str::format("fmt", v);
+  }
+
+
+  bool D3D9FrameCensus::DrawKey::operator == (const DrawKey& other) const {
+    for (uint32_t i = 0; i < caps::MaxSimultaneousRenderTargets; i++) {
+      if (rt[i] != other.rt[i])
+        return false;
+    }
+
+    return ds == other.ds && vs == other.vs && ps == other.ps
+        && sampled == other.sampled && otherTextures == other.otherTextures;
+  }
+
+
+  D3D9FrameCensus::D3D9FrameCensus(const D3D9Options& Options)
+  : m_key             (Options.frameCensusKey),
+    m_framesToCapture (std::max(1, std::min(Options.frameCensusFrames, 8))),
+    m_autoFrame       (uint32_t(std::max(0, Options.frameCensusAtFrame))) {
+    std::string exe = env::getExePath();
+    auto n = exe.find_last_of("\\/");
+    m_dir = n != std::string::npos ? exe.substr(0, n + 1) : std::string();
+
+    std::string table = Options.frameCensusShaderNames;
+    bool absolute = table.size() > 1 && (table[1] == ':' || table[0] == '\\' || table[0] == '/');
+    LoadTable(absolute ? table : m_dir + table);
+
+    Logger::info(str::format("D3D9 frame census: armed, key VK ", m_key, ", frames ", m_framesToCapture,
+      m_autoFrame ? str::format(", auto at frame ", m_autoFrame) : std::string(), ", ", m_table.size(), " shader names"));
+  }
+
+
+  void D3D9FrameCensus::LoadTable(const std::string& path) {
+    std::ifstream file(str::topath(path.c_str()).c_str());
+
+    if (!file) {
+      Logger::warn(str::format("D3D9 frame census: shader name table not found: ", path));
+      return;
+    }
+
+    std::unordered_map<std::string, uint32_t> shared;
+    std::string line;
+
+    while (std::getline(file, line)) {
+      if (line.empty() || line[0] == '#')
+        continue;
+
+      std::istringstream fields(line);
+      std::string sha1, stage, effect, technique, pass;
+
+      if (!(fields >> sha1 >> stage >> effect >> technique >> pass))
+        continue;
+
+      std::string name = effect + "/" + technique + (pass != "-" ? "/" + pass : std::string());
+      auto entry = m_table.find(sha1);
+
+      // The same bytecode can be shared by several techniques (e.g. full-screen
+      // vertex shaders): keep the first name and count the others
+      if (entry == m_table.end())
+        m_table.emplace(sha1, name);
+      else
+        shared[sha1] += 1u;
+    }
+
+    for (const auto& s : shared)
+      m_table[s.first] += str::format("(+", s.second, ")");
+  }
+
+
+  uint32_t D3D9FrameCensus::NameShader(const void* pBytecode, size_t Length, bool Pixel) {
+    std::string sha1 = Sha1Hash::compute(pBytecode, Length).toString();
+    auto entry = m_shaderIds.find(sha1);
+
+    if (entry != m_shaderIds.end())
+      return entry->second;
+
+    auto name = m_table.find(sha1);
+
+    ShaderInfo info;
+    info.sha1  = sha1;
+    info.name  = name != m_table.end() ? name->second : std::string();
+    info.pixel = Pixel;
+
+    m_shaders.push_back(std::move(info));
+    uint32_t id = uint32_t(m_shaders.size());
+    m_shaderIds.emplace(sha1, id);
+    return id;
+  }
+
+
+  std::string D3D9FrameCensus::ShaderName(uint32_t Id) const {
+    if (!Id)
+      return "FF";
+
+    const ShaderInfo& info = m_shaders.at(Id - 1);
+    return info.name.empty()
+      ? str::format("?", info.sha1.substr(0, 12))
+      : info.name;
+  }
+
+
+  uint32_t D3D9FrameCensus::ResourceId(D3D9CommonTexture* pTexture, D3D9Surface* pSurface) {
+    if (pTexture == nullptr)
+      return 0u;
+
+    auto entry = m_resourceIds.find(pTexture);
+
+    if (entry != m_resourceIds.end())
+      return entry->second;
+
+    const D3D9_COMMON_TEXTURE_DESC* desc = pTexture->Desc();
+
+    std::string kind = desc->IsBackBuffer ? "backbuffer"
+      : (desc->Usage & D3DUSAGE_DEPTHSTENCIL) ? "depth"
+      : (desc->Usage & D3DUSAGE_RENDERTARGET) ? "rendertarget"
+      : "texture";
+
+    bool sampleable = pSurface == nullptr || pSurface->GetBaseTexture() != nullptr;
+
+    ResourceInfo info;
+    info.desc = str::format(kind, " ", desc->Width, "x", desc->Height,
+      desc->ArraySize > 1 ? str::format(" layers=", desc->ArraySize) : std::string(),
+      " ", FormatName(desc->Format),
+      " mips=", desc->MipLevels,
+      desc->MultiSample ? str::format(" msaa=", uint32_t(desc->MultiSample)) : std::string(),
+      sampleable ? " sampleable" : " surface-only");
+
+    m_resources.push_back(std::move(info));
+    uint32_t id = uint32_t(m_resources.size());
+    m_resourceIds.emplace(pTexture, id);
+    return id;
+  }
+
+
+  D3D9FrameCensus::DrawKey D3D9FrameCensus::MakeKey(Direct3DState9& State) {
+    DrawKey key;
+
+    for (uint32_t i = 0; i < caps::MaxSimultaneousRenderTargets; i++) {
+      D3D9Surface* rt = State.renderTargets[i].ptr();
+      key.rt[i] = rt != nullptr ? ResourceId(rt->GetCommonTexture(), rt) : 0u;
+    }
+
+    D3D9Surface* ds = State.depthStencil.ptr();
+    key.ds = ds != nullptr ? ResourceId(ds->GetCommonTexture(), ds) : 0u;
+
+    key.vs = State.vertexShader != nullptr ? State.vertexShader->GetCensusId() : 0u;
+    key.ps = State.pixelShader  != nullptr ? State.pixelShader->GetCensusId()  : 0u;
+
+    for (uint32_t i = 0; i < SamplerCount; i++) {
+      IDirect3DBaseTexture9* texture = State.textures[i];
+
+      if (texture == nullptr)
+        continue;
+
+      D3D9CommonTexture* common = GetCommonTexture(texture);
+
+      if (common->Desc()->Usage & (D3DUSAGE_RENDERTARGET | D3DUSAGE_DEPTHSTENCIL))
+        key.sampled.emplace_back(i, ResourceId(common, nullptr));
+      else
+        key.otherTextures += 1u;
+    }
+
+    return key;
+  }
+
+
+  void D3D9FrameCensus::OnDraw(Direct3DState9& State, const char* pKind, uint32_t PrimitiveCount) {
+    DrawKey key = MakeKey(State);
+
+    // First draw of each named pixel shader in the capture: keep c0-c15, the values the
+    // engine feeds to the pass (needed to rewrite engine shaders, e.g. the tonemap)
+    if (key.ps && !m_shaders[key.ps - 1].name.empty() && m_psConstants.find(key.ps) == m_psConstants.end()) {
+      std::string consts;
+
+      for (uint32_t i = 0; i < 16u; i++) {
+        const auto& c = State.psConsts->fConsts[i];
+        consts += str::format(i ? " " : "", "c", i, "=(", c.x, ",", c.y, ",", c.z, ",", c.w, ")");
+      }
+
+      m_psConstants.emplace(key.ps, std::move(consts));
+    }
+
+    if (!m_events.empty()) {
+      Event& last = m_events.back();
+
+      if (last.text.empty() && last.frame == m_captureFrame && last.kind == pKind && last.key == key) {
+        last.draws += 1u;
+        last.prims += PrimitiveCount;
+        return;
+      }
+    }
+
+    for (uint32_t i = 0; i < caps::MaxSimultaneousRenderTargets; i++) {
+      if (key.rt[i])
+        m_resources[key.rt[i] - 1].writes += 1u;
+    }
+
+    for (const auto& s : key.sampled)
+      m_resources[s.second - 1].reads += 1u;
+
+    Event e;
+    e.key   = std::move(key);
+    e.kind  = pKind;
+    e.frame = m_captureFrame;
+    e.draws = 1u;
+    e.prims = PrimitiveCount;
+    m_events.push_back(std::move(e));
+  }
+
+
+  void D3D9FrameCensus::OnClear(Direct3DState9& State, DWORD Flags, D3DCOLOR Color, float Z, DWORD RectCount) {
+    char color[16] = { };
+    std::snprintf(color, sizeof(color), "%08x", unsigned(Color));
+
+    Event e;
+    e.key   = MakeKey(State);
+    e.kind  = "Clear";
+    e.frame = m_captureFrame;
+    e.text  = str::format("Clear",
+      (Flags & D3DCLEAR_TARGET)  ? str::format(" color=0x", color) : std::string(),
+      (Flags & D3DCLEAR_ZBUFFER) ? str::format(" z=", Z) : std::string(),
+      (Flags & D3DCLEAR_STENCIL) ? " stencil" : "",
+      RectCount ? str::format(" rects=", RectCount) : std::string());
+    m_events.push_back(std::move(e));
+  }
+
+
+  void D3D9FrameCensus::OnStretchRect(D3D9Surface* pSrc, D3D9Surface* pDst, D3DTEXTUREFILTERTYPE Filter) {
+    uint32_t src = ResourceId(pSrc->GetCommonTexture(), pSrc);
+    uint32_t dst = ResourceId(pDst->GetCommonTexture(), pDst);
+    m_resources[src - 1].reads  += 1u;
+    m_resources[dst - 1].writes += 1u;
+
+    Event e;
+    e.kind  = "StretchRect";
+    e.frame = m_captureFrame;
+    e.text  = str::format("StretchRect R", src, " mip", pSrc->GetMipLevel(),
+      " -> R", dst, " mip", pDst->GetMipLevel(), " filter=", uint32_t(Filter));
+    m_events.push_back(std::move(e));
+  }
+
+
+  void D3D9FrameCensus::OnPresent() {
+    m_presentCount += 1u;
+
+    if (m_capturing) {
+      m_captureFrame += 1u;
+
+      if (--m_framesLeft == 0u) {
+        m_capturing = false;
+        Write();
+        m_events.clear();
+      }
+
+      return;
+    }
+
+    bool trigger = m_autoFrame != 0u && m_presentCount == m_autoFrame;
+
+    if (m_key > 0) {
+      bool down = (GetAsyncKeyState(m_key) & 0x8000) != 0;
+      trigger |= down && !m_keyDown;
+      m_keyDown = down;
+    }
+
+    if (trigger) {
+      m_capturing    = true;
+      m_framesLeft   = m_framesToCapture;
+      m_captureFrame = 0u;
+      m_firstFrame   = m_presentCount + 1u;
+      m_resourceIds.clear();
+      m_resources.clear();
+      m_psConstants.clear();
+      Logger::info(str::format("D3D9 frame census: capturing ", m_framesToCapture, " frame(s) from frame ", m_firstFrame));
+    }
+  }
+
+
+  std::string D3D9FrameCensus::FormatKey(const DrawKey& Key) const {
+    std::string rts;
+
+    for (uint32_t i = 0; i < caps::MaxSimultaneousRenderTargets; i++) {
+      if (Key.rt[i])
+        rts += str::format(rts.empty() ? "" : ",", "R", Key.rt[i]);
+    }
+
+    std::string sampled;
+
+    for (const auto& s : Key.sampled)
+      sampled += str::format(" s", s.first, "=R", s.second);
+
+    return str::format("RT=", rts.empty() ? std::string("-") : rts,
+      " DS=", Key.ds ? str::format("R", Key.ds) : std::string("-"),
+      " VS=", ShaderName(Key.vs), " PS=", ShaderName(Key.ps),
+      sampled.empty() ? std::string() : " reads" + sampled,
+      " tex=", Key.otherTextures);
+  }
+
+
+  void D3D9FrameCensus::Write() {
+    std::time_t now = std::time(nullptr);
+    char stamp[32] = { };
+    std::strftime(stamp, sizeof(stamp), "%Y%m%d_%H%M%S", std::localtime(&now));
+
+    std::string path = m_dir + "Div2Reborn_census_" + stamp + ".txt";
+    std::ofstream out(str::topath(path.c_str()).c_str());
+
+    if (!out) {
+      Logger::err(str::format("D3D9 frame census: cannot write ", path));
+      return;
+    }
+
+    uint32_t draws = 0u, segments = 0u, unknown = 0u;
+
+    for (const auto& e : m_events) {
+      if (e.text.empty()) {
+        draws    += e.draws;
+        segments += 1u;
+      }
+    }
+
+    out << "# Divinity II Reborn frame census (DXVK patch 0009). Diagnostic only, rendering unchanged.\n";
+    out << "# frames " << m_firstFrame << ".." << (m_firstFrame + m_framesToCapture - 1u)
+        << ", draws " << draws << " in " << segments << " segments, events " << m_events.size() << "\n";
+    out << "# segment: <frame>.<n> <kind> x<draws> prims=<n> RT=<targets> DS=<depth> VS/PS=<effect/technique/pass | ?sha1 | FF>"
+           " reads s<sampler>=R<id> (render targets sampled) tex=<other textures>\n\n";
+
+    out << "## Resources (render targets, depth buffers, sampled targets)\n";
+
+    for (uint32_t i = 0; i < m_resources.size(); i++) {
+      const ResourceInfo& r = m_resources[i];
+      out << "R" << (i + 1) << " " << r.desc << " writes=" << r.writes << " reads=" << r.reads << "\n";
+    }
+
+    out << "\n## Events\n";
+    uint32_t n = 0u, frame = ~0u;
+
+    for (const auto& e : m_events) {
+      if (e.frame != frame) {
+        frame = e.frame;
+        n = 0u;
+        out << "### frame " << (m_firstFrame + frame) << "\n";
+      }
+
+      n += 1u;
+      out << frame << "." << n << " ";
+
+      if (e.text.empty())
+        out << e.kind << " x" << e.draws << " prims=" << e.prims << " " << FormatKey(e.key) << "\n";
+      else if (e.kind == "Clear")
+        out << e.text << " " << FormatKey(e.key) << "\n";
+      else
+        out << e.text << "\n";
+    }
+
+    out << "\n## Pixel shader constants c0-c15 at the first draw of each named pixel shader\n";
+
+    for (const auto& c : m_psConstants)
+      out << ShaderName(c.first) << " " << c.second << "\n";
+
+    out << "\n## Shaders created so far without a name in the table\n";
+
+    for (uint32_t i = 0; i < m_shaders.size(); i++) {
+      if (m_shaders[i].name.empty()) {
+        unknown += 1u;
+        out << (m_shaders[i].pixel ? "ps " : "vs ") << m_shaders[i].sha1 << "\n";
+      }
+    }
+
+    out << "# " << m_shaders.size() << " shaders created, " << unknown << " without a name\n";
+    Logger::info(str::format("D3D9 frame census: wrote ", path, " (", draws, " draws, ", segments, " segments)"));
+  }
+
+}
