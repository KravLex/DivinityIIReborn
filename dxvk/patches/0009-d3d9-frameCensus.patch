+   * \brief Divinity II Reborn frame census
+   *
+   * Diagnostic only, never changes what is rendered. When armed by the
+   * hotkey (or at a given frame number) it records every draw, clear and
+   * StretchRect of the next frames: bound render targets and depth-stencil,
+   * vertex/pixel shader (named through a table of bytecode SHA-1 ->
+   * effect / technique / pass, generated by tools/re/fx_effects.py) and the
+   * render-target textures that are sampled. Consecutive draws with the same
+   * state are merged into one line. The result is written next to the exe.
+   */
+  class D3D9FrameCensus {
+
+  public:
+
+    D3D9FrameCensus(const D3D9Options& Options);
+
+    /**
+     * \brief Registers a created shader
+     * \returns Census id to store in the shader object (never 0)
+     */
+    uint32_t NameShader(const void* pBytecode, size_t Length, bool Pixel);
+
+    bool IsCapturing() const {
+      return m_capturing;
+    }
+
+    void OnDraw(Direct3DState9& State, const char* pKind, uint32_t PrimitiveCount);
+
+    void OnClear(Direct3DState9& State, DWORD Flags, D3DCOLOR Color, float Z, DWORD RectCount);
+
+    void OnStretchRect(D3D9Surface* pSrc, D3D9Surface* pDst, D3DTEXTUREFILTERTYPE Filter);
+
+    void OnPresent();
+
+  private:
+
+    struct ShaderInfo {
+      std::string sha1;
+      std::string name;
+      bool        pixel;
+    };
+
+    struct ResourceInfo {
+      std::string desc;
+      uint32_t    writes = 0u;
+      uint32_t    reads  = 0u;
+    };
+
+    struct DrawKey {
+      uint32_t rt[caps::MaxSimultaneousRenderTargets] = { };
+      uint32_t ds = 0u;
+      uint32_t vs = 0u;
+      uint32_t ps = 0u;
+      std::vector<std::pair<uint32_t, uint32_t>> sampled;   // sampler -> resource id (RT/DS textures only)
+      uint32_t otherTextures = 0u;
+
+      bool operator == (const DrawKey& other) const;
+    };
+
+    struct Event {
+      DrawKey     key;
+      std::string kind;
+      std::string text;
+      uint32_t    frame = 0u;
+      uint32_t    draws = 0u;
+      uint64_t    prims = 0u;
+    };
+
+    std::unordered_map<std::string, std::string> m_table;
+    std::unordered_map<std::string, uint32_t>    m_shaderIds;
+    std::vector<ShaderInfo>                      m_shaders;
+
+    std::unordered_map<const void*, uint32_t>    m_resourceIds;
+    std::vector<ResourceInfo>                    m_resources;
+
+    std::vector<Event> m_events;
+
+    std::unordered_map<uint32_t, std::string>    m_psConstants;
+
+    std::string m_dir;
+    int32_t     m_key;
+    uint32_t    m_framesToCapture;
+    uint32_t    m_autoFrame;
+    uint32_t    m_presentCount  = 0u;
+    uint32_t    m_framesLeft    = 0u;
+    uint32_t    m_captureFrame  = 0u;
+    uint32_t    m_firstFrame    = 0u;
+    bool        m_keyDown       = false;
+    bool        m_capturing     = false;
+
+    void LoadTable(const std::string& path);
+
+    DrawKey MakeKey(Direct3DState9& State);
+
+    uint32_t ResourceId(D3D9CommonTexture* pTexture, D3D9Surface* pSurface);
+
+    std::string ShaderName(uint32_t Id) const;
+
+    std::string FormatKey(const DrawKey& Key) const;
+
+    void Write();
+
+  };
+
+}
