diff --git a/src/d3d9/d3d9_parallel_copy.cpp b/src/d3d9/d3d9_parallel_copy.cpp
new file mode 100644
index 0000000..9e0609e
--- /dev/null
+++ b/src/d3d9/d3d9_parallel_copy.cpp
@@ -0,0 +1,95 @@
+#include "d3d9_parallel_copy.h"
+
+#include <algorithm>
+#include <cstring>
+
+#include "../util/util_env.h"
+#include "../util/util_string.h"
+#include "../util/log/log.h"
+
+namespace dxvk {
+
+  D3D9ParallelCopy* D3D9ParallelCopy::get(uint32_t threads) {
+    // Intentionally leaked: workers live until the process exits
+    static D3D9ParallelCopy* s_pool = new D3D9ParallelCopy(threads);
+    return s_pool;
+  }
+
+
+  D3D9ParallelCopy::D3D9ParallelCopy(uint32_t threads) {
+    uint32_t workers = std::clamp(threads, 1u, 8u) - 1u;
+    m_jobs.resize(workers);
+
+    for (uint32_t i = 0; i < workers; i++) {
+      dxvk::thread t([this, i] { runWorker(i); });
+      t.detach();
+      m_workers++;
+    }
+
+    Logger::info(str::format("D3D9: parallel managed upload, ", m_workers + 1, " threads per level >= ", MinParallelSize >> 20, " MB"));
+  }
+
+
+  void D3D9ParallelCopy::copy(void* dst, const void* src, size_t size) {
+    if (size < MinParallelSize || !m_workers || !m_busy.try_lock()) {
+      std::memcpy(dst, src, size);
+      return;
+    }
+
+    // Page-aligned parts; the caller copies the last (largest) one
+    const uint32_t parts = m_workers + 1;
+    const size_t part = (size / parts) & ~size_t(4095);
+    auto d = reinterpret_cast<uint8_t*>(dst);
+    auto s = reinterpret_cast<const uint8_t*>(src);
+
+    if (!part) {
+      std::memcpy(dst, src, size);
+      m_busy.unlock();
+      return;
+    }
+
+    size_t offset = 0;
+
+    { std::unique_lock<dxvk::mutex> lock(m_mutex);
+      for (uint32_t i = 0; i < m_workers; i++) {
+        m_jobs[i] = { d + offset, s + offset, part };
+        offset += part;
+      }
+      m_pending = m_workers;
+      m_generation++;
+    }
+
+    m_cond.notify_all();
+    std::memcpy(d + offset, s + offset, size - offset);
+
+    { std::unique_lock<dxvk::mutex> lock(m_mutex);
+      m_doneCond.wait(lock, [this] { return m_pending == 0; });
+    }
+
+    m_busy.unlock();
+  }
+
+
+  void D3D9ParallelCopy::runWorker(uint32_t index) {
+    env::setThreadName("dxvk-d3d9-copy");
+    uint64_t seen = 0;
+
+    while (true) {
+      Job job;
+
+      { std::unique_lock<dxvk::mutex> lock(m_mutex);
+        m_cond.wait(lock, [this, seen] { return m_generation != seen; });
+        seen = m_generation;
+        job = m_jobs[index];
+      }
+
+      std::memcpy(job.dst, job.src, job.size);
+
+      { std::unique_lock<dxvk::mutex> lock(m_mutex);
+        if (!--m_pending)
+          m_doneCond.notify_one();
+      }
+    }
+  }
+
+}
diff --git a/src/d3d9/d3d9_parallel_copy.h b/src/d3d9/d3d9_parallel_copy.h
new file mode 100644
index 0000000..57e81d3
--- /dev/null
+++ b/src/d3d9/d3d9_parallel_copy.h
@@ -0,0 +1,66 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+#include "../util/thread.h"
+
+namespace dxvk {
+
+  /**
+   * \brief Splits a large memcpy between the calling thread and worker threads
+   *
+   * Used by d3d9.parallelManagedUploadThreads: packing a managed texture from its
+   * unmappable (file-backed) copy into the staging buffer is bound by page faults on
+   * freshly mapped memory, which the kernel handles in parallel. The copy returns only
+   * once every part is done. One pool per process, never destroyed (workers are
+   * daemon threads), so CS commands may use it regardless of device lifetime.
+   */
+  class D3D9ParallelCopy {
+
+  public:
+
+    /// Copies smaller than this are done by the calling thread alone
+    static constexpr size_t MinParallelSize = size_t(1u) << 20;
+
+    /**
+     * \brief Gets the process-wide pool
+     * \param [in] threads Total threads per copy including the caller (first call decides)
+     */
+    static D3D9ParallelCopy* get(uint32_t threads);
+
+    /**
+     * \brief Copies \c size bytes, in parallel if large enough
+     *
+     * Concurrent callers are serialized; a caller that finds the
+     * pool busy copies alone instead of waiting.
+     */
+    void copy(void* dst, const void* src, size_t size);
+
+    uint32_t threadCount() const { return m_workers + 1; }
+
+  private:
+
+    struct Job {
+      uint8_t*        dst  = nullptr;
+      const uint8_t*  src  = nullptr;
+      size_t          size = 0;
+    };
+
+    explicit D3D9ParallelCopy(uint32_t threads);
+
+    void runWorker(uint32_t index);
+
+    uint32_t                  m_workers = 0;
+    dxvk::mutex               m_busy;
+    dxvk::mutex               m_mutex;
+    dxvk::condition_variable  m_cond;
+    dxvk::condition_variable  m_doneCond;
+    std::vector<Job>          m_jobs;
+    uint64_t                  m_generation = 0;
+    uint32_t                  m_pending = 0;
+
+  };
+
+}
