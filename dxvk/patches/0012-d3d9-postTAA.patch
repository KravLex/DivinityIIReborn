+        elements[e.UsageIndex] = &e;
+    }
+
+    for (uint32_t i = 0; i < 4; i++) {
+      if (!elements[i] || elements[i]->Type > D3DDECLTYPE_FLOAT4 || elements[i]->Stream >= caps::MaxStreams) {
+        m_postAA->CameraUnavailable("unexpected vertex declaration");
+        return;
+      }
+    }
+
+    if (FirstVertex < 0 || NumVertices > 8u) {
