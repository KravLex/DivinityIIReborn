+          ? reinterpret_cast<const uint8_t*>(buffer->GetMappedSlice()->mapPtr()) : nullptr;
+        uint32_t components = uint32_t(e.Type) + 1u;
+        size_t offset = size_t(vbo.offset) + size_t(UINT(FirstVertex) + v) * vbo.stride + e.Offset;
