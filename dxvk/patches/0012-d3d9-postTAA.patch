+  // Inverse of a row-major 3x3 matrix; false if (nearly) singular
+  static bool Invert3(const float m[9], float inv[9]) {
+    float c0 = m[4] * m[8] - m[5] * m[7];
+    float c1 = m[5] * m[6] - m[3] * m[8];
+    float c2 = m[3] * m[7] - m[4] * m[6];
+    float det = m[0] * c0 + m[1] * c1 + m[2] * c2;
+    float scale = std::fabs(m[0]) + std::fabs(m[4]) + std::fabs(m[8]) + 1e-30f;
+
+    if (!(std::fabs(det) > 1e-9f * scale * scale * scale))
+      return false;
+
+    float r = 1.0f / det;
+    inv[0] = c0 * r; inv[1] = (m[2] * m[7] - m[1] * m[8]) * r; inv[2] = (m[1] * m[5] - m[2] * m[4]) * r;
