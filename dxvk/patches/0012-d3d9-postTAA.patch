+      return;
+    }
+
+    D3D9PostCameraVertex vertices[8];
+
+    for (UINT v = 0; v < NumVertices; v++) {
+      float data[4][4];
+
+      for (uint32_t i = 0; i < 4; i++) {
+        const D3DVERTEXELEMENT9& e = *elements[i];
+        const D3D9VBO& vbo = m_state.vertexBuffers[e.Stream];
