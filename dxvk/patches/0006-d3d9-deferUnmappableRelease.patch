diff --git a/src/util/util_unmap.cpp b/src/util/util_unmap.cpp
index b23842c..8a82293 100644
--- a/src/util/util_unmap.cpp
+++ b/src/util/util_unmap.cpp
@@ -1,4 +1,5 @@
 #include "util_unmap.h"
+#include "util_env.h"
 
 #include "./log/log.h"
 
@@ -80,6 +81,78 @@ namespace dxvk {
 
 
 
+  namespace {
+
+    std::atomic<bool> g_deferredRelease = { false };
+
+    /**
+     * \brief Destroys retired memory files on its own thread
+     *
+     * One per process, never destroyed: the thread lives until the
+     * process exits, so pools may retire files at any time.
+     */
+    class MemoryFileReaper {
+
+    public:
+
+      static MemoryFileReaper& get() {
+        static MemoryFileReaper* s_reaper = new MemoryFileReaper();
+        return *s_reaper;
+      }
+
+      void push(MemoryFile&& file) {
+        { std::lock_guard lock(m_mutex);
+          m_files.push_back(std::move(file));
+        }
+
+        m_cond.notify_one();
+      }
+
+    private:
+
+      MemoryFileReaper() {
+        dxvk::thread thread([this] { run(); });
+        thread.detach();
+      }
+
+      void run() {
+        env::setThreadName("dxvk-unmap-free");
+        std::vector<MemoryFile> files;
+
+        while (true) {
+          { std::unique_lock lock(m_mutex);
+            m_cond.wait(lock, [this] { return !m_files.empty(); });
+            files.swap(m_files);
+          }
+
+          // Closes the file mappings outside of the lock
+          files.clear();
+        }
+      }
+
+      dxvk::mutex               m_mutex;
+      dxvk::condition_variable  m_cond;
+      std::vector<MemoryFile>   m_files;
+
+    };
+
+  }
+
+
+  void MemoryFilePool::setDeferredRelease(bool enable) {
+    if (enable && !g_deferredRelease.exchange(true))
+      Logger::info("D3D9: unmappable memory released on a background thread");
+  }
+
+
+  void MemoryFilePool::retire(MemoryFile&& file) {
+    if (g_deferredRelease.load(std::memory_order_relaxed))
+      MemoryFileReaper::get().push(std::move(file));
+    else
+      MemoryFile(std::move(file));
+  }
+
+
   MemoryFilePool::MemoryFilePool()
   : m_poolAllocator(m_pageAllocator) {
 
