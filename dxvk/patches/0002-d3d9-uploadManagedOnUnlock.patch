diff --git a/src/d3d9/d3d9_device.cpp b/src/d3d9/d3d9_device.cpp
index 9b72bb2..0659798 100644
--- a/src/d3d9/d3d9_device.cpp
+++ b/src/d3d9/d3d9_device.cpp
@@ -5227,6 +5227,17 @@ namespace dxvk {
     MapTexture(pResource, Subresource); // Add it to the list of mapped resources
     pResource->SetLocked(Subresource, false);
 
+    // Upload managed textures now instead of at the first draw that uses them (d3d9.uploadManagedOnUnlock).
+    // The data is still mapped here; at draw time the unmappable copy has usually been unmapped again,
+    // so the upload has to map it once more (a page fault per page) and read it from cold memory.
+    if (unlikely(m_d3d9Options.uploadManagedOnUnlock)
+     && pResource->IsManaged()
+     && pResource->GetMapMode() == D3D9_COMMON_TEXTURE_MAP_MODE_UNMAPPABLE
+     && pResource->NeedsUpload(Subresource)) {
+      this->FlushImage(pResource, Subresource);
+      pResource->SetNeedsUpload(Subresource, false);
+    }
+
     // Flush image contents from staging if we aren't read only
     // and we aren't deferring for managed.
     const D3DBOX& box = pResource->GetDirtyBox(Face);
