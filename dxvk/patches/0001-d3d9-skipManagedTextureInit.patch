+    // Zeroing the unmappable copy of a managed texture costs a map, a page fault per page
+    // and a full memset, all on the application thread. Games that write every level
+    // before using the texture can skip it (d3d9.skipManagedTextureInit).
+    if (!pInitialData
+     && pTexture->Desc()->Pool == D3DPOOL_MANAGED
+     && pTexture->GetMapMode() == D3D9_COMMON_TEXTURE_MAP_MODE_UNMAPPABLE
+     && m_parent->GetOptions()->skipManagedTextureInit) {
+      if (pTexture->GetImage() != nullptr)
+        InitDeviceLocalTexture(pTexture);
+
+      SyncSharedTexture(pTexture);
+      return;
+    }
+
     void* mapPtr = nullptr;
 
