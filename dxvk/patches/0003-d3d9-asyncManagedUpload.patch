+  /**
+   * \brief Independent mapping of an unmappable allocation
+   *
+   * Holds its own map reference on the allocation, so the memory stays mapped
+   * and allocated while the pin exists, even if the owning region unmaps or
+   * frees it in the meantime (the free is then deferred to the last unmap).
+   * Mapping and unmapping are serialized by the pool, so a pin may be created
+   * on one thread and released on another (e.g. the CS thread).
+   */
+  class MemoryFilePin {
+
+  public:
+
+    MemoryFilePin() = default;
+
+    explicit MemoryFilePin(const MemoryFileRegion& region)
+    : m_pool(region.pool()), m_allocation(region.allocation()) {
+      if (m_pool && m_allocation >= 0)
+        m_mapPtr = m_pool->map(m_allocation);
+      else
+        m_pool = nullptr;
+    }
+
+    ~MemoryFilePin() {
+      release();
+    }
+
+    MemoryFilePin(MemoryFilePin&& other)
+    : m_pool      (std::exchange(other.m_pool,       nullptr))
+    , m_allocation(std::exchange(other.m_allocation, -1))
+    , m_mapPtr    (std::exchange(other.m_mapPtr,     nullptr)) { }
+
+    MemoryFilePin& operator = (MemoryFilePin&& other) {
+      release();
+      m_pool       = std::exchange(other.m_pool,       nullptr);
+      m_allocation = std::exchange(other.m_allocation, -1);
+      m_mapPtr     = std::exchange(other.m_mapPtr,     nullptr);
+      return *this;
+    }
+
+    MemoryFilePin(const MemoryFilePin&) = delete;
+    MemoryFilePin& operator = (const MemoryFilePin&) = delete;
+
+    const void* ptr() const {
+      return m_mapPtr;
+    }
+
+    explicit operator bool () const {
+      return m_mapPtr != nullptr;
+    }
+
+    void release() {
+      if (m_pool && m_allocation >= 0)
+        m_pool->unmap(m_allocation);
+
+      m_pool       = nullptr;
+      m_allocation = -1;
+      m_mapPtr     = nullptr;
+    }
+
+  private:
+
+    MemoryFilePool* m_pool        = nullptr;
+    int32_t         m_allocation  = -1;
